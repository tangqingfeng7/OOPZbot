{
  "plugin_name": "arc_raiders",
  "fields": [
    {
      "name": "enabled",
      "type": "boolean",
      "required": false,
      "description": "是否启用插件",
      "default": false,
      "example": false
    },
    {
      "name": "index_url",
      "type": "string",
      "required": false,
      "description": "物品索引JSON地址",
      "default": "https://arctracker.io/generated/client/items/items-index.zh-CN.json",
      "example": "https://arctracker.io/generated/client/items/items-index.zh-CN.json"
    },
    {
      "name": "stats_api_base",
      "type": "string",
      "required": false,
      "description": "掉率API基础地址",
      "default": "https://arctracker.io/api/stats/items",
      "example": "https://arctracker.io/api/stats/items"
    },
    {
      "name": "item_page_base",
      "type": "string",
      "required": false,
      "description": "物品详情页地址(英文页，用于提取场景)",
      "default": "https://arctracker.io/items",
      "example": "https://arctracker.io/items"
    },
    {
      "name": "zh_item_page_base",
      "type": "string",
      "required": false,
      "description": "中文详情页地址（用于截图）",
      "default": "https://arctracker.io/zh-CN/items",
      "example": "https://arctracker.io/zh-CN/items"
    },
    {
      "name": "cache_ttl_sec",
      "type": "integer",
      "required": false,
      "description": "物品索引缓存秒数",
      "constraint": ">= 60",
      "default": 600,
      "example": 600
    },
    {
      "name": "request_timeout_sec",
      "type": "integer",
      "required": false,
      "description": "请求超时秒数",
      "constraint": ">= 3",
      "default": 12,
      "example": 12
    },
    {
      "name": "max_candidates",
      "type": "integer",
      "required": false,
      "description": "模糊匹配最大候选数量",
      "constraint": ">= 1",
      "default": 6,
      "example": 6
    },
    {
      "name": "image_mode",
      "type": "boolean",
      "required": false,
      "description": "是否优先返回图片截图",
      "default": true,
      "example": true
    },
    {
      "name": "render_timeout_sec",
      "type": "integer",
      "required": false,
      "description": "截图渲染超时秒数",
      "constraint": ">= 5",
      "default": 20,
      "example": 20
    },
    {
      "name": "temp_dir",
      "type": "string",
      "required": false,
      "description": "截图临时目录",
      "default": "data/arc_raiders",
      "example": "data/arc_raiders"
    }
  ]
}
